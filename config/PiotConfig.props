#####
# Configuration file for the Gateway Device App (GDA)
#
# This provides a section-based configuration format for use by
# ConfigUtil with keys defined in ConfigConst.
#
# IMPORTANT: Edit this file to meet your local system requirements.
#

#
# Cloud client configuration information
#
[Cloud.GatewayService]
credFile       = ./cred/PiotCloudCred.props
certFile       = ./cert/PiotCloudCert.pem
host           = localhost
port           = 1883
securePort     = 8883
defaultQoS     = 0
keepAlive      = 60
useAsyncClient = True
enableAuth     = True
enableCrypt    = True
baseUrl        = 
baseTopic      = 

#
# Ubidots Cloud Service Configuration
#
[Ubidots.GatewayService]
enableCloudClient = True
apiToken = BBUS-bXhM8XEgETMXPmMDaL08G96mHPvnXq
baseUrl = https://industrial.api.ubidots.com
basePath = /api/v1.6
deviceLabel = iot-gateway-001
useWebApi = False
useMqtt = True
host = industrial.api.ubidots.com
port = 1883
securePort = 8883
defaultQoS = 0
keepAlive = 60

#
# SMTP client configuration information
#
[Smtp.GatewayService]
credFile       = ./cred/PiotSmtpCred.props
host           = localhost
port           = 25
securePort     = 587
enableAuth     = True
enableCrypt    = True

#
# MQTT client configuration information
#
[Mqtt.GatewayService]
credFile       = ./cred/PiotMqttCred.props
certFile       = ./cert/PiotMqttLocalCertFile.pem
host           = localhost
port           = 1883
securePort     = 8883
defaultQoS     = 0
keepAlive      = 60
enableAuth     = False
enableCrypt    = False
useAsyncClient = False

#
# CoAP client and server configuration information
#
[Coap.GatewayService]
credFile       = ./cred/PiotCoapCred.props
certFile       = ./cert/PiotCoapLocalCertFile.pem
host           = localhost
port           = 5683
securePort     = 5684
enableAuth     = False
enableCrypt    = False
enableConfirmedMsgs = True

#
# Persistence client configuration
#
[Redis.GatewayService]
host = localhost
port = 6379

#
# GDA specific configuration information
#
[GatewayDevice]
deviceLocationID        = gatewaydevice001
enableLogging           = True
pollCycleSecs           = 60
enableMqttClient        = True
enableCoapServer        = False
enableCoapClient        = False
enableCloudClient       = True
enableSmtpClient        = False
enablePersistenceClient = False
enableSystemPerformance = True
testGdaDataPath         = /tmp/gda-data
testCdaDataPath         = /tmp/cda-data
testEmptyApp            = False